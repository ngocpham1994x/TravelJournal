@model TravelJournal.Models.Location

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Location</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PlaceName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PlaceName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Address)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Address)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.City.CityName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.City.CityName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.City.CountryName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.City.CountryName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Lat)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Lat)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Lon)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Lon)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DateVisit)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DateVisit)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TimeVisit)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TimeVisit)
        </dd>
    </dl>
</div>

<div class="container">
    <div class="row">
        <!-- Left Section: Google Map -->
        <div class="col-md-6">
            <h4>Location Map</h4>
            <hr />
            <div id="map" style="height: 400px; width: 100%;"></div>
        </div>

        <!-- Right Section: Weather Info -->
        <div class="col-md-6">
            <h4>Weather Information</h4>
            <hr />
            <p><strong>Temperature:</strong> @ViewData["Temperature"]</p>
        </div>
    </div>
</div>


<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
<script> 
     function initMap() { 
         var location = { lat: @Model.Lat, lng: @Model.Lon }; 
         var map = new google.maps.Map(document.getElementById("map"), { 
             zoom: 14, 
             center: location 
         }); 
         var marker = new google.maps.Marker({ 
             position: location, 
             map: map 
         }); 
     } 
</script>

<script async defer src="https://maps.googleapis.com/maps/api/js?key=AIzaSyA7JaM35ulMiCDEpnnncTAIPMA9o8OXYzQ&callback=initMap"></script>
}