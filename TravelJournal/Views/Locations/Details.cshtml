@model TravelJournal.Models.Location

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Location</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PlaceName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PlaceName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Address)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Address)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.City.CityName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.City.CityName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.City.CountryName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.City.CountryName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Lat)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Lat)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Lon)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Lon)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DateVisit)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DateVisit)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TimeVisit)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TimeVisit)
        </dd>
    </dl>
</div>

<div class="container">
    <div class="row">
        <!-- Left Section: Google Map -->
        <div class="col-md-6">
            <h4>Location Map</h4>
            <hr />
            <div id="map" style="height: 400px; width: 100%;"></div>
        </div>

        <!-- Right Section: Weather Info -->
        <div class="col-md-6">
            <h4>Weather Information</h4>
            <hr />
            <p><strong>Temperature:</strong> @ViewData["Temperature"]</p>
            @* <p><strong>Weather:</strong> <span id="weather-description">Loading...</span></p> *@
        </div>
    </div>
</div>


<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
